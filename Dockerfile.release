# Release image for scientific-process (MCP server over stdio). It packages the
# release binaries the release workflow already built, smoke-tested and listed
# in checksums.sha256, so the image runs exactly the released binary and no
# compilation happens under emulation. The image workflow
# (.github/workflows/image.yml) verifies the archives and unpacks them to
# dist/linux-<arch>/scientific-process before building. To build from source,
# use the Dockerfile instead.
FROM debian:trixie-slim
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 10001 app
COPY --chmod=0755 dist/linux-${TARGETARCH}/scientific-process /usr/local/bin/scientific-process
USER app
LABEL io.modelcontextprotocol.server.name="io.github.praxec/scientific-process"
# The gateway spawns this container with `docker run -i` and speaks MCP over stdio.
ENTRYPOINT ["scientific-process"]
